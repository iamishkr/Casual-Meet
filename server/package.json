    "mongodb-memory-server": "^10.1.3",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
